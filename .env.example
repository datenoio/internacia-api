# Copy to `.env` and adjust. Every value can also be set as an environment variable.

# Path to an internacia-db `internacia.duckdb` file (see README → "Get the database").
# If unset, the SDK looks in its download cache (~/.internacia/<version>/internacia.duckdb).
INTERNACIA_DB_PATH=./data/internacia.duckdb

# Server settings, used by `python -m app.main`
HOST=0.0.0.0
PORT=8000
DEBUG=False
