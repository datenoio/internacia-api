# Copy to `.env` and adjust. Every value can also be set as an environment variable.

# Path to an internacia-db `internacia.duckdb` file (see README → "Get the database").
# If unset, the SDK looks in its download cache (~/.internacia/<version>/internacia.duckdb).
INTERNACIA_DB_PATH=./data/internacia.duckdb

# Server settings, used by `python -m app.main`
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Allowed CORS origins as a JSON list (default: any origin, never with credentials)
# CORS_ORIGINS=["https://example.org"]

# Expected internacia-db version; startup fails if the database differs (the Docker image sets it)
# INTERNACIA_DB_VERSION=3.0.0

# Cache-Control max-age for successful responses, in seconds (0 turns caching headers off)
# CACHE_MAX_AGE=3600

# Load the full lists and catalogs into memory at startup (about 80 MB); false queries per request
# PRELOAD_CATALOGS=true
